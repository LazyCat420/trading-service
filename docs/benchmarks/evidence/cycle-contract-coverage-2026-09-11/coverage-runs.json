 "title": "Coverage sweep: the eight paths that had never run behind the Decision Synthesizer",
 "measured_at_utc": "2026-09-12",
 "deployed_revision": "4e77d051",
 "findings": [
  {
   "severity": "live defect on the then-deployed revision, FIXED in 4e77d051",
   "claim": "pipeline_service refused any BUY whose resolved size was not exactly the agent's requested size, gated on financial_evidence_version==1 which orchestrator.py:3264 sets for every ticker on every cycle. resolve_buy_size_pct applies a consensus/data-quality haircut by design, so equality is false whenever a consensus score exists.",
   "measured": {
    "buy_sizings_failing_the_equality": "54 of 55 over the last 600 production analyses",
    "the_one_survivor": "UBER, which carried no internal_consensus_score",
    "immediate_enter_now_buys_that_reach_the_line": 6,
    "of_those_refused": 5,
    "of_those_5_that_had_reached_EXECUTE_BUY": 4
   },
   "why_nothing_caught_it": "sizing_reconsideration_required is written twice and read nowhere, so the BUY was dropped silently; and no production cycle had yet run under the deployed revision."
  },
  {
   "severity": "open, NOT fixed \u2014 needs a design decision",
   "claim": "The compound-question path delivers and never collects. Three questions seeded through the production writer reached NINE agent prompts; none of the nine returned research_answers; finish_questions recorded answered=0 deferred=3.",
   "measured": {
    "agents_given_the_question_block": 9,
    "agents_that_returned_research_answers": 0,
    "artifacts_read_by_verified_answers": [
     "fundamental_report",
     "quant_report",
     "valuation_report",
     "desk_note"
    ],
    "artifacts_that_DO_emit_research_answers": [
     "board_of_directors",
     "decision_synthesizer"
    ],
    "note": "The two that comply are the two whose schema declares the field, and neither receives the question block nor is read for answers."
   }
  },
  {
   "severity": "harness blind spots, both now guarded",
   "claim": "trade=false skipped the whole execution block so the sizing gate was unreachable; and a bench- cycle id is synthetic, so claim_for_ticker returned [] and every staging run reported questions_required=0 whatever was in the queue."
  },
  {
   "severity": "measurement",
   "claim": "The raw-HTTP shim under-reports agent latency against the real run_agent transport.",
   "measured": {
    "v3_regime_engine_no_tools_either_run": {
     "shim_ms": 12570,
     "production_ms": 46235,
     "ratio": 3.7
    },
    "v3_junior_analyst": {
     "shim_ms": 15684,
     "production_ms": 153906,
     "ratio": 9.8
    },
    "v3_fundamental_analyst": {
     "shim_ms": 22766,
     "production_ms": 289780,
     "ratio": 12.7
    },
    "consequence": "The harness default --timeout is 1200s and r5-r7 all used it; a real-transport cycle cannot finish in that budget."
   }
  },
  {
   "severity": "measurement",
   "claim": "Investment merit is not measurable yet.",
   "measured": {
    "BUY_only": {
     "n": 17,
     "board_confidence_spread_pp": 0.94,
     "p": 0.531
    },
    "every_resolved_decision": {
     "n": 289,
     "board_confidence_spread_pp": -2.64,
     "p": 0.0,
     "caveat": "Mostly HOLDs carrying a hypothetical P&L, so this is about confidence calibration, not trading returns."
    }
   }
  }
 ]
