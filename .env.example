# Database Connections
# The store is MongoDB (cutover 2026-08-19). PRISM_MONGO_URI is the
# connection the service actually uses; app/config/config.py deleted the
# DATABASE_URL / TEST_DATABASE_URL settings fields on 2026-08-28 for exactly
# the reason this template used to undo: advertising a live-looking
# postgresql:// value invites the wrong conclusion about where the data is.
#
# The Postgres archive still exists — trading_bot is SHARED with
# treesearch-service — and it still answers, with data frozen on 2026-08-19,
# no error and no staleness marker. Its DSN belongs in .env.migration, loaded
# explicitly by the migration/parity tooling. See .env.migration.example.

# Services
# NOTE: production routes through the lazy-agent-service proxy, not prism
# directly — deploy.sh sets PRISM_URL="http://<NAS>:5591/prism-proxy".
PRISM_URL="http://<YOUR_NAS_IP>:5591/prism-proxy"
PRISM_ENABLED="true"
PRISM_MONGO_URI="mongodb://<MONGO_USER>:<MONGO_PASS>@<YOUR_NAS_IP>:27017/?directConnection=true&authSource=admin"
# SCRAPER_SERVICE_URL — base URL of the standalone scraper-service. The scraper
# was extracted back out of this process into its own service; app.services.
# scraper_client POSTs here for /scrape and /collect. Defaults to the docker DNS
# name http://scraper-service:8001 (see app/config/config.py).
SCRAPER_SERVICE_URL="http://scraper-service:8001"
USE_LAZY_TOOL_SERVICE="true"
LAZY_TOOL_SERVICE_URL="http://<YOUR_NAS_IP>:5591"
LAZY_TOOL_SERVICE_PORT="5591"

# API Keys
FINNHUB_API_KEY=""
FRED_API_KEY=""
FMP_API_KEY=""
EIA_API_KEY=""
AISSTREAM_API_KEY=""
MARKETAUX_API_KEY=""
NEWSAPI_API_KEY=""
ALPHAVANTAGE_API_KEY=""
POLYGON_API_KEY=""
MASSIVE_API_KEY=""
GNEWS_API_KEY=""
CURRENTS_API_KEY=""
THENEWSAPI_KEY=""
WORLDNEWSAPI_KEY=""
STOCKDATA_API_KEY=""
TWELVEDATA_API_KEY=""

# Security / User Agent Configuration
SEC_USER_AGENT="vllm-trading-bot <YOUR_GITHUB_EMAIL>"
API_SERVER_KEY="change-me-local-dev"
HERMES_API_KEY=""  # Leave empty for no-auth Hermes endpoints

# vLLM Endpoints
PROVIDER_VLLM_1_URL="http://<YOUR_JETSON_IP>:8000"
PROVIDER_VLLM_1_CONCURRENCY=8
PROVIDER_VLLM_2_URL="http://<YOUR_DGX_IP>:8000"
PROVIDER_VLLM_2_CONCURRENCY=16

# Debate System (V3 Family Office — CIO-driven dynamic debate)
# Set to "true" to enable V3 Civilization Council mode (default: false = V2 debate)

