# Database Connections
DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@<YOUR_NAS_IP>:5433/trading_bot"
TEST_DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@<YOUR_NAS_IP>:5433/trading_bot_test"

# Services
PRISM_URL="http://<YOUR_NAS_IP>:7777"
PRISM_MONGO_URI="mongodb://<MONGO_USER>:<MONGO_PASS>@<YOUR_NAS_IP>:27017/?directConnection=true&authSource=admin"
SCRAPER_SERVICE_URL="http://<YOUR_NAS_IP>:8001"
USE_LAZY_TOOL_SERVICE="true"
LAZY_TOOL_SERVICE_URL="http://localhost:5591"

# API Keys
FINNHUB_API_KEY=""
FRED_API_KEY=""
FMP_API_KEY=""
EIA_API_KEY=""
AISSTREAM_API_KEY=""
MARKETAUX_API_KEY=""
NEWSAPI_API_KEY=""
ALPHAVANTAGE_API_KEY=""
POLYGON_API_KEY=""
MASSIVE_API_KEY=""
GNEWS_API_KEY=""
CURRENTS_API_KEY=""
THENEWSAPI_KEY=""
WORLDNEWSAPI_KEY=""
STOCKDATA_API_KEY=""
TWELVEDATA_API_KEY=""

# Security / User Agent Configuration
SEC_USER_AGENT="vllm-trading-bot <YOUR_GITHUB_EMAIL>"
API_SERVER_KEY="change-me-local-dev"
HERMES_API_KEY=""  # Leave empty for no-auth Hermes endpoints

# vLLM Endpoints (Optional overrides)
JETSON_VLLM_URL="http://<YOUR_JETSON_IP>:8000"
DGX_SPARK_VLLM_URL="http://<YOUR_DGX_IP>:8000"

# Debate System (V3 Family Office — CIO-driven dynamic debate)
# Set to "true" to enable V3 Civilization Council mode (default: false = V2 debate)
V3_FAMILY_OFFICE_ENABLED="false"
