# ─── Python ───────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.env
# Every other .env variant too. `.env.migration` carries the Postgres
# ARCHIVE DSN — the one credential the retirement work still needs and the
# one that has never been rotated — and nothing was stopping it from being
# committed. The .example files stay tracked; they hold placeholders.
.env.*
!.env.example
!.env.migration.example
.venv/
venv/
.pytest_cache/
.deepeval/
.coverage
htmlcov/
.mypy_cache/

# ─── Node ─────────────────────────────────────────────────────
node_modules/
package-lock.json

# ─── Build / Deploy ──────────────────────────────────────────
.deploy-logs/
dist/
build/

# ─── Logs & Output ───────────────────────────────────────────
*.log
*_logs.txt
*_tail.txt
*_out.txt
docker_logs.txt
out.txt
cycle_run.log

# ─── Data / Runtime Artifacts ────────────────────────────────
scratch/
# `scratch/` does NOT match `.scratch/` — the leading dot makes it a different
# name. scripts/mine_shkreli_doctrine.py writes multi-GB transcript dumps there.
.scratch/
logs/
logs_local/
data/
# ANCHORED. `memory/` matched every directory of that name at any depth,
# including the tracked source package `app/services/memory/` — so `git add`
# refused a path inside it and `git status` had to be trusted instead. A rule
# that hides a source tree is one bad `git clean` from deleting it.
# `data/` above already covers `data/memory/`.
/memory/
plans/
reports/
test_mkdir_exist/
latest_desk.json

# ─── Debug & Query Scripts (local-only utilities) ────────────
scripts/debug/
scripts/migrations/

# ─── Generated Files ────────────────────────────────────────
tool_schemas.json

# ─── OS / IDE ────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
backups/
scripts/test_v3_agent.py

# CORAL repair loop: throwaway worktrees + cached test baselines
.evo-worktrees/

# EnterWorktree scratch worktrees (parallel sessions live here)
.claude/worktrees/

# The path parallel sessions actually use. Untracked, it blocks
# guard_deploy for the whole time any sibling session holds a worktree.
# (This Dockerfile COPYs named directories, so unlike trading-client's it
# would not have shipped the checkout in the image.)
.worktrees/
backfill_blocked_labels_undo.json
